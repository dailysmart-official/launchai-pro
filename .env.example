# Database
DATABASE_URL="postgresql://user:password@localhost:5432/launchai"

# Auth — Auth.js v5 canonical vars. Vercel aliases GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET and NEXTAUTH_SECRET are also accepted.
# PRIMARY (set these): AUTH_SECRET + AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET + NEXTAUTH_URL
# ALIASES (auto-mapped, for Vercel): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NEXTAUTH_SECRET, AUTH_URL
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI must include: {NEXTAUTH_URL}/api/auth/callback/google (e.g. https://launchai-pro.vercel.app/api/auth/callback/google)

# OpenAI
OPENAI_API_KEY="sk-..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
