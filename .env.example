# LaunchAI Pro — copy to .env (local) or paste into your host's env settings (Vercel).
# Never commit .env. See README.md for where to get each value.

# --- Database (required) ---
# PostgreSQL connection string. Neon/Supabase need ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app. Local: http://localhost:3000 — Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Google login (required for sign-in in production) ---
# Redirect URI to register in Google Cloud: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI Writer ---
OPENAI_API_KEY=""
# Optional — use another OpenAI-compatible provider. Leave empty for OpenAI (default model gpt-4o-mini).
# OpenRouter example:
#   OPENAI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_MODEL="openai/gpt-4o-mini"
OPENAI_BASE_URL=""
AI_MODEL=""

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Accepted aliases (optional — use these only if your host already defines them):
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET  -> AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
#   NEXTAUTH_SECRET                          -> AUTH_SECRET
