# LaunchAI Pro — copy to .env (local) or paste into your host's env settings (Vercel).
# Never commit .env. See README.md for where to get each value.

# --- Database (required) ---
# PostgreSQL connection string. Neon/Supabase need ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app. Local: http://localhost:3000 — Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Google login (required for sign-in in production) ---
# Redirect URI to register in Google Cloud: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI Writer ---
OPENAI_API_KEY=""
# Optional — use another OpenAI-compatible provider. Leave empty for OpenAI (default model gpt-4o-mini).
# OpenRouter example:
#   OPENAI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_MODEL="openai/gpt-4o-mini"
# OpenRouter model slugs (especially free ":free" ones) change often — check https://openrouter.ai/models
OPENAI_BASE_URL=""
AI_MODEL=""
# Optional — comma-separated models tried in order when AI_MODEL returns 429 (rate limited) or 404 (not found).
#   AI_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.1-flash"
# Paid models via OpenRouter (e.g. openai/gpt-4o-mini) only work if your OpenRouter account has credits.
AI_FALLBACK_MODELS=""

# --- Billing (Stripe) ---
# All read server-side at request time. No NEXT_PUBLIC_* variable and no publishable key are needed:
# checkout redirects to the Stripe-hosted page. Checkout activates when STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
# Optional — without it the Enterprise plan is not sold online (it never uses the Pro price).
STRIPE_PRICE_ENTERPRISE=""
# Optional — Enterprise "Contact sales" link (https://... or mailto:...). If empty, the card shows "Available on request".
SALES_CONTACT_URL=""

# Accepted aliases (optional — use these only if your host already defines them):
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET  -> AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
#   NEXTAUTH_SECRET                          -> AUTH_SECRET
